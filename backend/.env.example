# MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers → Python, then paste it here and fill in your password.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

DATABASE_NAME=techfix

# Vite dev server origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cashfree Payment Links (Dashboard → Developers → API Keys). Start with a Test/Sandbox
# App ID and Secret Key — switch CASHFREE_ENV to "production" only with live keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Where customers land after paying online (does not affect payment status tracking).
FRONTEND_URL=http://localhost:5173
